# PreVis Database Configuration
# Copy this file to .env and adjust values for your environment
#   cp .env.example .env        (Linux/macOS)
#   copy .env.example .env      (Windows)

DB_HOST=localhost
DB_PORT=5432
DB_NAME=previs_db
DB_USER=postgres
DB_PASSWORD=postgres
PORT=3000

# Ollama AI Chatbot Configuration
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3.5:0.8b

# ML Worker Configuration
# How often (seconds) the inference worker runs
ML_INFERENCE_INTERVAL_SECONDS=10

# Path to Python for the ML worker (auto-detected if not set)
# Linux/macOS: ML_PYTHON=ml/.venv/bin/python
# Windows:     ML_PYTHON=ml\.venv\Scripts\python.exe
# ML_PYTHON=
